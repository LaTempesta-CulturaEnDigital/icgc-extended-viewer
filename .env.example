# Docker Compose substitutions only. Copy to .env for local customization.
# The Python CLI does not automatically load this file.
VIEWER_PORT=8000
API_PORT=8002
API_PUBLIC_BASE_URL=http://localhost:8002
API_PREFIX_MODE=preserve
API_CORS_ORIGINS=["http://localhost:8000"]
ANNOTATION_BASE_URL=http://localhost:8081
# If API_PORT changes, also update API_PUBLIC_BASE_URL and
# frontend/public/config.json -> apiConfigUrl.
# If VIEWER_PORT changes, also update API_CORS_ORIGINS.
